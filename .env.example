# Research Engine configuration. Copy to .env and edit. Never commit .env.
# Placeholders and defaults only. Generate secrets with: openssl rand -hex 32

# ---- Core / identity ----
# API key required on REST, MCP and the GUI login
API_KEY=change-me
# Secret used to sign GUI session cookies
SESSION_SECRET=change-me
# Public hostname served by Caddy (example deployment uses research.toolbox)
SITE_HOST=research.localhost
# Git revision shown in /v1/health and used as the app image tag. Leave EMPTY: make deploy and
# make rollback export it per run. Empty means the compose defaults apply: image
# research-engine-app:dev, health git_sha "unknown".
GIT_SHA=
LOG_LEVEL=INFO
USER_AGENT=ResearchEngine/0.1 (+https://github.com/pentonvillefandango/research-engine)

# ---- Upstreams ----
# For local (non-compose) runs only; compose.yaml fixes both to the internal service names.
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11235
# Token for the Crawl4AI API
CRAWL4AI_API_TOKEN=change-me
# Compose-only: SearXNG secret key
SEARXNG_SECRET=change-me

# ---- Config files ----
INTENTS_FILE=config/intents.yaml
DEMOS_FILE=config/demos.yaml

# ---- Search ----
SEARCH_MIN_RESULTS=10
SEARCH_TIMEOUT_S=30

# ---- Fetch ----
PAGE_TIMEOUT_S=60
# Pages with fewer words than this are flagged thin
THIN_WORD_THRESHOLD=150
MAX_RESPONSE_BYTES=10485760
ALLOWED_CONTENT_TYPES=text/html,application/xhtml+xml,application/pdf,text/plain
# Comma-separated hostnames exempt from SSRF blocking (empty = none)
SSRF_ALLOW_HOSTS=
DOMAIN_CONCURRENCY=2
DOMAIN_DELAY_S=1.0

# ---- Cache ----
CACHE_TTL_SEARCH_S=3600
CACHE_TTL_PAGE_S=86400

# ---- Store / jobs / events ----
# For local runs only; compose.yaml overrides it to /data/research-engine.sqlite (app-data volume).
DB_PATH=data/research-engine.sqlite
JOB_WORKERS=2
JOB_FETCH_CONCURRENCY=5
JOB_TIMEOUT_S=900
EVENT_RETENTION_DAYS=30

# ---- Compose-only ----
# Subnet allowed through Caddy (CIDR); loopback only by default
LAB_SUBNET=127.0.0.1/32

# Optional debug port: when set, compose.debug.yaml publishes the app on 127.0.0.1:<APP_PORT> only.
# Leave empty normally (Caddy is the only way in). Pick a free port; never a fixed shared one.
APP_PORT=

# Hard resource limits per service (co-tenant host, REQUIREMENTS §9)
APP_MEM_LIMIT=1g
APP_CPUS=1.0
SEARXNG_MEM_LIMIT=512m
SEARXNG_CPUS=1.0
CRAWL4AI_MEM_LIMIT=4g
CRAWL4AI_CPUS=2.0
