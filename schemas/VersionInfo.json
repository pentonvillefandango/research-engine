{
  "$id": "research-engine/1.0.0/VersionInfo.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "git_sha": {
      "title": "Git Sha",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "git_sha",
    "schema_version"
  ],
  "title": "VersionInfo",
  "type": "object"
}
