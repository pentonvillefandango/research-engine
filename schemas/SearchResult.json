{
  "$id": "research-engine/1.0.0/SearchResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_url": {
      "title": "Canonical Url",
      "type": "string"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "engines": {
      "items": {
        "type": "string"
      },
      "title": "Engines",
      "type": "array"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "score": {
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "snippet": {
      "title": "Snippet",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "rank",
    "url",
    "canonical_url",
    "title",
    "snippet",
    "domain",
    "engines",
    "score",
    "published_at"
  ],
  "title": "SearchResult",
  "type": "object"
}
