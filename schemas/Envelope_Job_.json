{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthorized",
        "not_found",
        "ssrf_blocked",
        "robots_disallowed",
        "content_type_not_allowed",
        "response_too_large",
        "upstream_timeout",
        "upstream_error",
        "engine_failed",
        "fetch_failed",
        "extraction_failed",
        "job_cancelled",
        "job_timeout",
        "interrupted",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL, engine or component that failed",
          "title": "Source"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "source"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "Job": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          },
          "title": "Errors",
          "type": "array"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "progress": {
          "$ref": "#/$defs/JobProgress"
        },
        "request": {
          "additionalProperties": true,
          "title": "Request",
          "type": "object"
        },
        "result_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Ref"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "type": {
          "$ref": "#/$defs/JobType"
        }
      },
      "required": [
        "id",
        "type",
        "status",
        "progress",
        "parent_id",
        "session_id",
        "request",
        "result_ref",
        "errors",
        "created_at",
        "started_at",
        "finished_at"
      ],
      "title": "Job",
      "type": "object"
    },
    "JobProgress": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL or engine currently in use",
          "title": "Current"
        },
        "done": {
          "minimum": 0,
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total",
        "current"
      ],
      "title": "JobProgress",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "queued",
        "running",
        "partial",
        "done",
        "failed",
        "cancelled"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "JobType": {
      "enum": [
        "fetch_batch",
        "search_read"
      ],
      "title": "JobType",
      "type": "string"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "took_ms": {
          "minimum": 0,
          "title": "Took Ms",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "schema_version",
        "took_ms",
        "cache_hit"
      ],
      "title": "Meta",
      "type": "object"
    }
  },
  "$id": "research-engine/1.0.0/Envelope_Job_.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/Job"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "title": "Errors",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "data",
    "meta",
    "errors"
  ],
  "title": "Envelope_Job_",
  "type": "object"
}
