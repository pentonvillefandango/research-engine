{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthorized",
        "not_found",
        "ssrf_blocked",
        "robots_disallowed",
        "content_type_not_allowed",
        "response_too_large",
        "upstream_timeout",
        "upstream_error",
        "engine_failed",
        "fetch_failed",
        "extraction_failed",
        "job_cancelled",
        "job_timeout",
        "interrupted",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL, engine or component that failed",
          "title": "Source"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "Infobox": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "urls": {
          "items": {
            "$ref": "#/$defs/InfoboxLink"
          },
          "title": "Urls",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "Infobox",
      "type": "object"
    },
    "InfoboxLink": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "InfoboxLink",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "took_ms": {
          "minimum": 0,
          "title": "Took Ms",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "took_ms"
      ],
      "title": "Meta",
      "type": "object"
    },
    "SearchResponse": {
      "additionalProperties": false,
      "properties": {
        "infoboxes": {
          "items": {
            "$ref": "#/$defs/Infobox"
          },
          "title": "Infoboxes",
          "type": "array"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/SearchResult"
          },
          "title": "Results",
          "type": "array"
        },
        "suggestions": {
          "items": {
            "type": "string"
          },
          "title": "Suggestions",
          "type": "array"
        },
        "unresponsive_engines": {
          "items": {
            "$ref": "#/$defs/UnresponsiveEngine"
          },
          "title": "Unresponsive Engines",
          "type": "array"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchResponse",
      "type": "object"
    },
    "SearchResult": {
      "additionalProperties": false,
      "properties": {
        "canonical_url": {
          "title": "Canonical Url",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "engines": {
          "items": {
            "type": "string"
          },
          "title": "Engines",
          "type": "array"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "url",
        "canonical_url",
        "title",
        "snippet",
        "domain",
        "engines",
        "score"
      ],
      "title": "SearchResult",
      "type": "object"
    },
    "UnresponsiveEngine": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "error"
      ],
      "title": "UnresponsiveEngine",
      "type": "object"
    }
  },
  "$id": "research-engine/1.0.0/Envelope_SearchResponse_.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "title": "Errors",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "meta"
  ],
  "title": "Envelope_SearchResponse_",
  "type": "object"
}
