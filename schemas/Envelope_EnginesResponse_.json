{
  "$defs": {
    "EngineInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "used_by": {
          "items": {
            "$ref": "#/$defs/SearchIntent"
          },
          "title": "Used By",
          "type": "array"
        }
      },
      "required": [
        "name",
        "used_by"
      ],
      "title": "EngineInfo",
      "type": "object"
    },
    "EnginesResponse": {
      "additionalProperties": false,
      "properties": {
        "engines": {
          "items": {
            "$ref": "#/$defs/EngineInfo"
          },
          "title": "Engines",
          "type": "array"
        },
        "intents": {
          "additionalProperties": {
            "$ref": "#/$defs/IntentPreset"
          },
          "propertyNames": {
            "$ref": "#/$defs/SearchIntent"
          },
          "title": "Intents",
          "type": "object"
        }
      },
      "required": [
        "engines",
        "intents"
      ],
      "title": "EnginesResponse",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthorized",
        "not_found",
        "ssrf_blocked",
        "robots_disallowed",
        "content_type_not_allowed",
        "response_too_large",
        "upstream_timeout",
        "upstream_error",
        "engine_failed",
        "fetch_failed",
        "extraction_failed",
        "job_cancelled",
        "job_timeout",
        "interrupted",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL, engine or component that failed",
          "title": "Source"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "IntentPreset": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "engines": {
          "items": {
            "type": "string"
          },
          "title": "Engines",
          "type": "array"
        }
      },
      "required": [
        "categories",
        "engines",
        "description"
      ],
      "title": "IntentPreset",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "took_ms": {
          "minimum": 0,
          "title": "Took Ms",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "took_ms"
      ],
      "title": "Meta",
      "type": "object"
    },
    "SearchIntent": {
      "enum": [
        "general",
        "technical",
        "library",
        "product",
        "standard",
        "news",
        "academic"
      ],
      "title": "SearchIntent",
      "type": "string"
    }
  },
  "$id": "research-engine/1.0.0/Envelope_EnginesResponse_.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnginesResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "title": "Errors",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "meta"
  ],
  "title": "Envelope_EnginesResponse_",
  "type": "object"
}
